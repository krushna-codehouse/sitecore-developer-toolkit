{
  "name": "sitecore-developer-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Developer productivity toolkit for Sitecore Content SDK (Next.js) projects: scaffolding, diagnostics, GraphQL validation, quality gates and a health dashboard.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run sc:env:check && next dev",
    "dev:no-check": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "codegen": "graphql-codegen --config codegen.ts",
    "sc": "tsx scripts/cli.ts",
    "sc:env:check": "tsx scripts/cli.ts env:check",
    "sc:component:create": "tsx scripts/cli.ts component:create",
    "sc:component:check": "tsx scripts/cli.ts component:check",
    "sc:component:map": "tsx scripts/cli.ts component:map",
    "sc:graphql:schema": "tsx scripts/cli.ts graphql:schema",
    "sc:graphql:validate": "tsx scripts/cli.ts graphql:validate",
    "sc:content:check": "tsx scripts/cli.ts content:check",
    "sc:project:health": "tsx scripts/cli.ts project:health",
    "sc:validate": "tsx scripts/cli.ts validate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,graphql,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "graphql": "^16.15.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@next/env": "^15.5.29",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
