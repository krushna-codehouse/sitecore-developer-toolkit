# Copy to .env.local and fill in. Variable names are configured in toolkit.config.ts.

# Site
NEXT_PUBLIC_DEFAULT_SITE_NAME=your-site-name
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Option A: Experience Edge (XM Cloud / SitecoreAI)
SITECORE_EDGE_CONTEXT_ID=your-context-id
# SITECORE_EDGE_URL=https://edge-platform.sitecorecloud.io

# Option B: local / self-hosted CM
# SITECORE_API_HOST=https://xmcloudcm.localhost
# SITECORE_API_KEY=your-api-key

# Editing host
SITECORE_EDITING_SECRET=your-editing-secret
